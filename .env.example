# Copy this file to `.env` and fill in the values you need for your mode.
#
# THERE ARE TWO ORTHOGONAL SWITCHES:
#
#   MODE      paper | live
#       paper -> simulated fills only.  No DERIBIT_CLIENT_ID/SECRET needed
#                (we only call PUBLIC market-data endpoints).  All state
#                tracked in data/*_paper.* files.  This is the default.
#       live  -> REAL orders sent to Deribit.  Requires DRY_RUN=false to
#                actually trade.  State tracked in data/*_live.* files.
#
#   DRY_RUN   true | false
#       true  -> print the action plan but DO NOT persist state or send
#                orders.  Useful for one-shot inspection in any mode.
#       false -> actually execute (paper: simulate fill + persist;
#                live: send real order + persist).
#
# Recommended progression:
#   1. MODE=paper, DRY_RUN=false  -- run for 1-2+ weeks to build a paper
#                                    track record (no creds required)
#   2. MODE=live,  DRY_RUN=true   -- one-shot check that creds + position
#                                    fetch all work, no real orders
#   3. MODE=live,  DRY_RUN=false  -- you're trading for real

MODE=paper
DRY_RUN=false

# Total capital (USD).  Per-fund slice = CAPITAL_USD * asset_weight / N_funds
# where asset_weight is 0.5 if both BTC and ETH are firing, 1.0 if only one.
CAPITAL_USD=3000

# Paper-mode execution costs (ignored in live mode).  Defaults reflect
# Deribit USDC perp taker fee (5 bps) plus a small slippage estimate.
FEE_BPS=5
SLIPPAGE_BPS=2

# ----- Live-mode credentials (only required when MODE=live) -----
# Generate keys at:
#   testnet :  https://test.deribit.com/account/BTC/api/api
#   prod    :  https://www.deribit.com/account/BTC/api/api
# Credentials are venue-specific -- testnet keys do NOT work on prod.
# Recommended permissions:
#   - account:read         (view balances + positions)
#   - trade:read_write     (place / cancel orders)
#   - DO NOT enable wallet:read_write unless you also need transfers.
DERIBIT_CLIENT_ID=
DERIBIT_CLIENT_SECRET=

# ----- Venue routing (data vs trading split) ------------------------
# DATA_ENV   - where market data is fetched (option chains, index,
#              funding, instrument specs).  ALWAYS leave on 'live':
#              testnet option chains are too thin/synthetic for the
#              skew_z signals to be meaningful.
# TRADE_ENV  - where ORDERS are placed and OUR positions are read.
#              Default 'test' so a misconfigured run hits monopoly
#              money.  Flip to 'live' only after a clean testnet
#              track record.
DATA_ENV=live
TRADE_ENV=test
